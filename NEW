/**
 * KilkennyBros Plumbing — Job Sheet submission backend.
 *
 * HOW THIS WORKS
 * The job sheet app (on Tim's and Daniel's iPads, and yours) sends each
 * completed job sheet here as soon as "Complete & Prepare Job Sheet" is
 * tapped and there's a signal. This script:
 *   1. Saves the attached PDF into the "Submitted PDFs" Drive folder.
 *   2. Adds a row to this spreadsheet with the job details + a link to the PDF.
 *   3. Emails kilkennybros@bigpond.com to say a new job sheet has arrived.
 *
 * Everyone logged into the same Google account sees the same spreadsheet —
 * that's the shared "inbox". Tick the "Invoiced" box in column B once
 * you've invoiced a job, so the whole team can see what has and hasn't
 * been invoiced yet.
 * The app's own "Team" tab also reads from here (via doGet) and can tick
 * "Invoiced" for you (via doPost) without anyone opening the spreadsheet.
 *
 * SETUP (one-off, see the deployment instructions sent with this file):
 *   1. Open the "KilkennyBros Job Sheets - Submissions" spreadsheet.
 *   2. Extensions > Apps Script, delete the placeholder code, paste this
 *      whole file in, Save.
 *   3. Run the "setupSheet" function once (see the dropdown next to the
 *      Run button) to format the header row and tick-boxes.
 *   4. Deploy > New deployment > Web app > Execute as: Me,
 *      Who has access: Anyone > Deploy.
 *   5. Copy the Web app URL it gives you and send it back so it can be
 *      wired into the job sheet app.
 */

// ---- configuration -------------------------------------------------------

var PDF_FOLDER_ID = "1CrkkgXlNzTuA8PyH6c8AVbAXWfVAoKUJ"; // "Submitted PDFs" folder
var NOTIFY_EMAIL = "kilkennybros@bigpond.com";
// Lightweight shared secret so random internet traffic can't spam the sheet.
// This must match SYNC_TOKEN in the job sheet app's HTML file exactly.
var SHARED_SECRET = "5Pyu7ExXCgw3gvle95-fF9-r6L4W-RUq";

// ---------------------------------------------------------------------------

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return jsonResponse({ ok: false, error: "No data received" });
    }
    var data = JSON.parse(e.postData.contents);

    if (data.token !== SHARED_SECRET) {
      return jsonResponse({ ok: false, error: "Invalid token" });
    }

    if (data.action === "markProcessed") {
      return handleMarkProcessed(data);
    }
    return handleSubmission(data);
  } catch (err) {
    return jsonResponse({ ok: false, error: String(err) });
  }
}

function handleSubmission(data) {
  var jobCode = String(data.jobCode || "job").replace(/[^a-zA-Z0-9_-]+/g, "_");
  var pdfUrl = "";

  if (data.pdfBase64) {
    var folder = DriveApp.getFolderById(PDF_FOLDER_ID);
    var bytes = Utilities.base64Decode(data.pdfBase64);
    var blob = Utilities.newBlob(bytes, "application/pdf", "JobSheet_" + jobCode + "_" + Date.now() + ".pdf");
    var file = folder.createFile(blob);
    pdfUrl = file.getUrl();
  }

  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  var rowNum = sheet.getLastRow() + 1;
  sheet.getRange(rowNum, 1, 1, 10).setValues([[
    new Date(),
    false,
    data.jobCode || "",
    data.customer || "",
    data.jobType || "",
    data.jobDate || "",
    data.siteAddress || "",
    (data.workers || []).join(", "),
    data.total || "",
    pdfUrl
  ]]);
  sheet.getRange(rowNum, 2, 1, 1).insertCheckboxes();

  sendNotification(data, pdfUrl);

  return jsonResponse({ ok: true });
}

/**
 * Ticks or unticks the "Invoiced" checkbox for one row, sent from the
 * app's "Team" tab when someone taps the Invoiced checkbox there.
 */
function handleMarkProcessed(data) {
  var row = parseInt(data.rowIndex, 10);
  if (!row || row < 2) {
    return jsonResponse({ ok: false, error: "Bad row index" });
  }
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  sheet.getRange(row, 2, 1, 1).setValue(!!data.processed);
  return jsonResponse({ ok: true });
}

/**
 * Returns the most recent submissions as JSON so the app's "Team" tab can
 * show everyone's job sheets, not just the ones done on this device.
 * Called as: <Web App URL>?token=...
 */
function doGet(e) {
  var token = e && e.parameter && e.parameter.token;
  if (token !== SHARED_SECRET) {
    return jsonResponse({ ok: false, error: "Invalid token" });
  }
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
    var lastRow = sheet.getLastRow();
    var sheetUrl = SpreadsheetApp.getActiveSpreadsheet().getUrl();
    if (lastRow < 2) {
      return jsonResponse({ ok: true, rows: [], sheetUrl: sheetUrl });
    }
    var numRows = Math.min(lastRow - 1, 200);
    var startRow = lastRow - numRows + 1;
    var values = sheet.getRange(startRow, 1, numRows, 10).getValues();
    var rows = [];
    for (var i = values.length - 1; i >= 0; i--) {
      var r = values[i];
      rows.push({
        rowIndex: startRow + i,
        timestamp: (r[0] instanceof Date) ? r[0].toISOString() : String(r[0]),
        processed: !!r[1],
        jobCode: r[2],
        customer: r[3],
        jobType: r[4],
        jobDate: r[5],
        siteAddress: r[6],
        workers: r[7],
        total: r[8],
        pdfUrl: r[9]
      });
    }
    return jsonResponse({ ok: true, rows: rows, sheetUrl: sheetUrl });
  } catch (err) {
    return jsonResponse({ ok: false, error: String(err) });
  }
}

function sendNotification(data, pdfUrl) {
  var sheetUrl = SpreadsheetApp.getActiveSpreadsheet().getUrl();
  var subject = "New job sheet submitted — " + (data.jobCode || "") + " (" + (data.customer || "") + ")";
  var body =
    "A new job sheet has come in.\n\n" +
    "Job Code: " + (data.jobCode || "-") + "\n" +
    "Customer: " + (data.customer || "-") + "\n" +
    "Type: " + (data.jobType || "-") + "\n" +
    "Date: " + (data.jobDate || "-") + "\n" +
    "Site Address: " + (data.siteAddress || "-") + "\n" +
    "Workers: " + ((data.workers || []).join(", ") || "-") + "\n" +
    "Total (inc GST): " + (data.total || "-") + "\n\n" +
    "View in the spreadsheet: " + sheetUrl + "\n" +
    (pdfUrl ? ("PDF: " + pdfUrl + "\n") : "");
  MailApp.sendEmail(NOTIFY_EMAIL, subject, body);
}

/**
 * Run this ONCE from the Apps Script editor (select it in the function
 * dropdown next to the Run button, then click Run) to format the header
 * row and set up tick-boxes for the Invoiced column.
 */
function setupSheet() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  var headers = ["Timestamp", "Invoiced", "Job Code", "Customer", "Job Type", "Date", "Site Address", "Workers", "Total (inc GST)", "PDF Link"];
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  sheet.getRange(1, 1, 1, headers.length).setFontWeight("bold").setBackground("#0b3d63").setFontColor("#ffffff");
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 150);
  sheet.setColumnWidth(2, 90);
  sheet.setColumnWidth(4, 160);
  sheet.setColumnWidth(7, 200);
  sheet.setColumnWidth(8, 160);
  sheet.setColumnWidth(10, 220);
  // Pre-apply checkboxes to the Invoiced column for the next 2000 rows
  // so every future submission automatically shows a tick-box.
  sheet.getRange(2, 2, 2000, 1).insertCheckboxes();
}

function jsonResponse(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
